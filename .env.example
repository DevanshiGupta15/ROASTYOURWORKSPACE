# =========================================================================
# ROAST YOUR WORKSPACE — ENVIRONMENT CONFIGURATION
# =========================================================================

# Application Server Port
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# -------------------------------------------------------------
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION (Step 2)
# -------------------------------------------------------------
# If configured, server connects to Supabase / PostgreSQL.
# If omitted or empty, the server automatically uses the high-performance
# resilient local database adapter (data/database.json) with strict multi-tenant
# room isolation and 2-hour Auto-TTL whisper management out of the box!

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for client queries with Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Secret (for admin overrides / automated background jobs)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct PostgreSQL Connection String (used by Prisma ORM or pg client)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?schema=public"

# -------------------------------------------------------------
# ROOM ISOLATION & SECURITY
# -------------------------------------------------------------
# Session Secret for cookie / JWT signing
SESSION_SECRET=tadka_chai_super_secret_session_key_2026

# Decency Engine Strict Mode (true = block post on abusive Hindi/English slang; false = warning only)
DECENCY_STRICT_MODE=true

# Whisper Ephemeral TTL in seconds (default: 7200 seconds = 2 Hours)
WHISPER_TTL_SECONDS=7200
